<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd plist for OpenEMR daily backup. To install:
    cp scripts/com.openemr.backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.openemr.backup.plist

  To trigger manually:
    launchctl start com.openemr.backup

  To stop:
    launchctl unload ~/Library/LaunchAgents/com.openemr.backup.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openemr.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Applications/XAMPP/xamppfiles/htdocs/openemr/scripts/backup.sh</string>
  </array>

  <!-- Daily at 23:30 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- Inherit PATH so `docker` is found -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/openemr-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/openemr-backup.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
