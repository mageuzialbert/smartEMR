# VPS .env template — copy to `.env` on the VPS and fill in real values.
# This file (the .example) is safe to commit; the real `.env` is gitignored.
#
# Generate strong values on the VPS, e.g.:  openssl rand -base64 24
#
# IMPORTANT (restore vs fresh-install):
#   - On a RESTORE (loading the migrated dump), the OpenEMR admin password comes
#     from the dump (= the admin password in the source host's SECRETS.txt line [3]),
#     NOT from OE_ADMIN_PASS below. OE_ADMIN_PASS only takes effect on a fresh install.
#   - MYSQL_USER_PASS must equal the password you write into the restored
#     sites/default/sqlconf.php ($pass), or OpenEMR cannot connect to the DB.

# MariaDB root password (container's root user)
MYSQL_ROOT_PASS=__GENERATE_ME__

# Password for the application DB user `smartemr`
# (must match $pass in sites/default/sqlconf.php)
MYSQL_USER_PASS=__GENERATE_ME__

# OpenEMR admin password — only used on a FRESH install (ignored on restore)
OE_ADMIN_PASS=__GENERATE_ME__
